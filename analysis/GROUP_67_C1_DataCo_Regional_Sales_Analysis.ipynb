   "source": [
    "ventas_descuento = (\n",
    "    df.groupby(\"Category Name\")\n",
    "      .agg(\n",
    "          unidades_vendidas=(\"Order Item Quantity\", \"sum\"),\n",
    "          descuento_promedio=(\"Order Item Discount Rate\", \"mean\")\n",
    "      )\n",
    "      .sort_values(\"unidades_vendidas\", ascending=False)\n",
    ")\n",
    "\n",
    "display(ventas_descuento)"
   ]
